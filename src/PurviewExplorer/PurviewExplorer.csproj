  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SardaCloud.PurviewExplorer</RootNamespace>
    <AssemblyName>PurviewExplorer</AssemblyName>
    <AssemblyTitle>Purview Explorer</AssemblyTitle>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\PurviewExplorer.ico</ApplicationIcon>
    <GenerateResourceUsePreserializedResources>false</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <!--
    Released builds are per architecture: dotnet build -p:Platform=x64 or -p:Platform=ARM64 (see build.ps1).
    ARM64 needs .NET Framework 4.8.1, the first version that runs natively on Arm64 (Windows 11).
    The default AnyCPU build is what the tests use.
  -->
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <TargetFramework>net481</TargetFramework>
    <PlatformTarget>ARM64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Compile against Windows PowerShell 5.1; at run time System.Management.Automation comes from the GAC. -->
    <PackageReference Include="Microsoft.PowerShell.5.1.ReferenceAssemblies" Version="1.0.0" PrivateAssets="all" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\demo-snapshot.json" LogicalName="PurviewExplorer.DemoSnapshot.json" />
    <EmbeddedResource Include="Resources\PurviewExplorer.ico" LogicalName="PurviewExplorer.AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PurviewExplorer.Tests" />
  </ItemGroup>

</Project>
